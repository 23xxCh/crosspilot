# API 密钥（不要把真实值提交到版本库）
DEEPSEEK_KEY=
AGNES_KEY=
GPT_IMAGE_KEY=

# 使用 crosspilot/model_profiles.json 中的配置档
MODEL_PROFILE=production
PROMPT_PROFILE=production

# Agnes 白天拥堵：503 快速重试一次后切换回退模型
AGNES_503_RETRY_LIMIT=1
AGNES_503_BACKOFF_MIN_S=3
AGNES_503_BACKOFF_MAX_S=8
AGNES_503_CIRCUIT_THRESHOLD=3
AGNES_503_CIRCUIT_COOLDOWN_S=120

# 如需临时覆盖模型，可在这里修改；留空时使用配置档默认值
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_TEXT_FALLBACK_MODEL=deepseek-v4-pro
AGNES_TEXT_MODEL=agnes-2.0-flash
AGNES_VISION_MODEL=agnes-2.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_IMAGE_FALLBACK_MODEL=agnes-image-2.0-flash
GPT_IMAGE_MODEL=gpt-image-2

# 并发与运行策略
IMAGE_GEN_CONCURRENCY=20
TEXT_CONCURRENCY=100
REVIEW_CONCURRENCY=30
MAX_ROWS=0
# Amazon 生成图固定执行下载、解码和结构化风险复审，不提供关闭开关
